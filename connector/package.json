{
  "name": "encounter-tracker-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets Claude read (and later build) encounters in the Encounter Tracker's data file.",
  "bin": {
    "encounter-tracker-connector": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p . --noEmit && node build.mjs",
    "start": "node dist/index.js",
    "test": "cd .. && vitest run connector",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "esbuild": "^0.25.10",
    "typescript": "^5.8.3"
  }
}
